# Public client configuration only. Never put a Supabase service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Use your staging deployment during development; HTTPS required outside local development.
EXPO_PUBLIC_API_URL=https://your-staging-domain.example/api
EXPO_PUBLIC_WEB_URL=https://your-staging-domain.example
EXPO_PUBLIC_DESIGN_PREVIEW=false
